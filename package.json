{
  "name": "tw-overlay",
  "version": "3.1.4",
  "description": "TalesWeaver Companion Browser",
  "main": "dist/main.js",
  "scripts": {
    "build-tools": "tsc -p tsconfig.scripts.json",
    "build": "npm run build-tools && node dist-tools/copy-resources.js && tsc",
    "build:store-helper": "npm run build-tools && node dist-tools/build-store-update-helper.js",
    "start": "npm run build && electron .",
    "only-dev": "electron . --dev",
    "dev": "npm run build && electron . --dev",
    "dev:tools": "npm run build && electron . --dev --devtools",
    "dist": "npm run build && electron-builder --win",
    "dist:appx": "npm run build && npm run build:store-helper && electron-builder --win appx && node dist-tools/verify-appx-package.js",
    "verify:appx": "npm run build-tools && node dist-tools/verify-appx-package.js",
    "postinstall": "electron-builder install-app-deps",
    "parse-equipment": "npm run build-tools && node dist-tools/parse-equipment.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test:renderer": "electron dist-tools/check-renderer-behavior.js",
    "test:guide": "electron dist-tools/check-guide-behavior.js",
    "test:diary-calendar": "electron dist-tools/check-diary-calendar-behavior.js",
    "test:buffs": "electron dist-tools/check-buffs-behavior.js",
    "test:eta-ranking": "electron dist-tools/check-eta-ranking-behavior.js",
    "test:xp-policy": "electron dist-tools/check-xp-hud-policy.js",
    "test:window-visibility": "electron dist-tools/check-window-visibility.js",
    "test:companion-design": "electron dist-tools/check-companion-design.js",
    "test:companion": "electron dist-tools/check-companion-features.js",
    "test:hunting-assist": "electron dist-tools/check-hunting-assist.js",
    "test:abandoned-visibility": "electron dist-tools/check-abandoned-visibility-policy.js",
    "test:audit": "electron dist-tools/check-audit-regressions.js",
    "test:autostart": "electron dist-tools/check-auto-start.js",
    "test:stress": "npm run build && electron dist-tools/stress-test-high-throughput.js && electron dist-tools/stress-test-sustained.js",
    "capture:guide": "npm run build && electron dist-tools/capture-guide-screenshots.js",
    "build:zorder-fixture": "dotnet build scripts/fixtures/FakeTalesWeaver/FakeTalesWeaver.csproj --configuration Release --nologo",
    "test:zorder:windows": "npm run build && npm run build:zorder-fixture && electron dist-tools/runtime-zorder-windows-probe.js",
    "test": "npm run build && electron dist-tools/check-refactor-regressions.js && npm run test:renderer && npm run test:guide && npm run test:diary-calendar && npm run test:buffs && npm run test:eta-ranking && npm run test:xp-policy && npm run test:hunting-assist && npm run test:companion && npm run test:companion-design && npm run test:companion-reading && npm run test:companion-files && npm run test:shared-layout && npm run test:hud-edit-settings && npm run test:npc-chat && npm run test:chat-visibility && npm run test:preset-position && npm run test:window-visibility && npm run test:abandoned-visibility && npm run test:audit && npm run test:autostart && npm run test:stopwatch && npm run test:magic-stone && npm run test:hunting-path && npm run test:embedded-tools",
    "test:companion-reading": "electron dist-tools/check-companion-reading.js",
    "test:companion-files": "electron dist-tools/check-companion-files.js",
    "test:shared-layout": "electron dist-tools/check-shared-layout.js",
    "test:hud-edit-settings": "electron dist-tools/check-hud-edit-settings.js",
    "test:npc-chat": "electron dist-tools/check-npc-chat.js",
    "test:chat-visibility": "electron dist-tools/check-chat-visibility.js",
    "test:preset-position": "electron dist-tools/check-preset-position.js",
    "test:stopwatch": "electron dist-tools/check-stopwatch-session.js",
    "test:magic-stone": "electron dist-tools/check-magic-stone-revenue.js",
    "test:hunting-path": "electron dist-tools/check-hunting-path.js",
    "test:embedded-tools": "electron dist-tools/check-embedded-tools.js"
  },
  "build": {
    "appId": "com.filbertlab.twoverlay",
    "productName": "twOverlay",
    "directories": {
      "output": "dist_electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "twliker",
        "repo": "tw-overlay"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/koffi/**",
      "dist/store-update-helper/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icons/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "appx": {
      "applicationId": "twOverlay",
      "identityName": "FilbertLab.TW-Overlay",
      "publisher": "CN=6BAF7511-7890-43A4-8630-498F620A5370",
      "publisherDisplayName": "FilbertLab",
      "displayName": "TW-Overlay",
      "backgroundColor": "#0b0f19",
      "minVersion": "10.0.17763.0",
      "customManifestPath": "appx/appxmanifest.xml",
      "capabilities": [
        "runFullTrust",
        "allowElevation"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist/assets/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.3.2"
  },
  "keywords": [],
  "author": "filbertlab",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "entities": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "koffi": "^3.1.4",
    "tail": "^2.2.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/tail": "^2.2.3",
    "electron": "^42.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  }
}
